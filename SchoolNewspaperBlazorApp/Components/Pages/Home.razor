@page "/"
@using System.Globalization
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService articleService
@inject IFileService fileService

<PageTitle>Gazetka szkolna</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

    .news ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
    }

    .news ::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, .02);
    }

    .news ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #3B82F6, #F59E0B);
        border-radius: 999px;
        border: 2px solid transparent;
        background-clip: padding-box;
    }

    .news {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        min-height: 640px;
        padding: clamp(1.5rem, 4vw, 3rem);
        border-radius: 28px;
        background: radial-gradient(1100px 600px at 15% -10%, rgba(56, 132, 255, .20), transparent 60%), radial-gradient(900px 500px at 100% 5%, rgba(56, 189, 248, .12), transparent 55%), radial-gradient(900px 600px at 85% 105%, rgba(234, 140, 60, .14), transparent 60%), radial-gradient(700px 500px at 5% 100%, rgba(200, 90, 40, .10), transparent 60%), linear-gradient(180deg, #0A1428 0%, #0A1224 55%, #0B1120 100%);
        color: #E6EEFB;
        font-family: "Inter", "Segoe UI", system-ui, sans-serif;
        box-shadow: 0 40px 90px -40px rgba(2, 8, 23, .9), inset 0 0 0 1px rgba(120, 170, 255, .08);
    }

        .news::before,
        .news::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            opacity: .5;
            pointer-events: none;
            z-index: 0;
        }

        .news::before {
            top: -140px;
            left: -120px;
            width: 520px;
            height: 520px;
            background: radial-gradient(circle, rgba(59, 130, 246, .55), transparent 70%);
            animation: np-glow 18s ease-in-out infinite alternate;
        }

        .news::after {
            bottom: -180px;
            right: -140px;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(234, 140, 60, .35), transparent 70%);
            animation: np-glow 22s ease-in-out infinite alternate-reverse;
        }

    @@keyframes np-glow {
        from {
            transform: translate3d(0, 0, 0) scale(1);
            opacity: .45;
        }

        to {
            transform: translate3d(20px, -20px, 0) scale(1.08);
            opacity: .6;
        }
    }

    .news .np-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(160, 200, 255, .05) 1px, transparent 1px), linear-gradient(90deg, rgba(160, 200, 255, .05) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse at 50% 0%, #000 25%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 25%, transparent 75%);
    }

    .news .np-leaves {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        overflow: hidden;
    }

    .news .np-leaf {
        position: absolute;
        top: -10%;
        left: var(--x);
        width: var(--s);
        height: var(--s);
        color: var(--c);
        opacity: 0;
        animation: np-fall var(--dur) linear var(--delay) infinite;
        will-change: transform, opacity;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, .35));
    }

        .news .np-leaf svg {
            display: block;
            width: 100%;
            height: 100%;
            transform-origin: 50% 50%;
            animation: np-sway var(--sway, 4s) ease-in-out infinite alternate;
        }

    @@keyframes np-fall {
        0% {
            opacity: 0;
            transform: translate3d(0, -10vh, 0) rotate(0deg);
        }

        8% {
            opacity: var(--op, .8);
        }

        90% {
            opacity: var(--op, .8);
        }

        100% {
            opacity: 0;
            transform: translate3d(var(--dx, 60px), 110vh, 0) rotate(var(--rot, 360deg));
        }
    }

    @@keyframes np-sway {
        from {
            transform: rotate(-12deg) scale(1);
        }

        to {
            transform: rotate(12deg) scale(.96);
        }
    }

    .news .np-head {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.2rem;
        flex-wrap: wrap;
        padding-bottom: 1.1rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid rgba(140, 180, 255, .14);
    }

    .news .np-brand {
        display: flex;
        align-items: center;
        gap: .85rem;
    }

    .news .np-logo {
        position: relative;
        display: grid;
        place-items: center;
        width: 2.7rem;
        height: 2.7rem;
        border-radius: 14px;
        background: linear-gradient(135deg, #3B82F6 0%, #38BDF8 55%, #F59E0B 130%);
        color: #fff;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: -.02em;
        box-shadow: 0 14px 30px -12px rgba(56, 132, 255, .8), inset 0 1px 0 rgba(255, 255, 255, .35);
    }

        .news .np-logo::after {
            content: "";
            position: absolute;
            inset: -3px;
            border-radius: 16px;
            background: linear-gradient(135deg, rgba(56, 132, 255, .35), rgba(245, 158, 11, .35));
            filter: blur(8px);
            z-index: -1;
            opacity: .6;
        }

    .news .np-brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
    }

    .news .np-brand-name {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-weight: 800;
        font-size: 1.15rem;
        letter-spacing: -.01em;
        color: #FFFFFF;
    }

    .news .np-brand-sub {
        font-size: .78rem;
        color: #7E93BC;
        letter-spacing: .04em;
    }

    .news .np-meta {
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
        font-size: .82rem;
        color: #9BB0D3;
    }

    .news .np-chip {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .42rem .85rem;
        border-radius: 999px;
        background: rgba(90, 140, 220, .12);
        border: 1px solid rgba(120, 170, 255, .22);
        color: #C7D6F1;
        font-weight: 500;
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
        transition: border-color .2s ease, background .2s ease;
    }

        .news .np-chip:hover {
            border-color: rgba(120, 170, 255, .45);
            background: rgba(90, 140, 220, .18);
        }

        .news .np-chip.amber {
            background: rgba(245, 158, 11, .14);
            border-color: rgba(245, 158, 11, .32);
            color: #FCD9A0;
        }

            .news .np-chip.amber:hover {
                border-color: rgba(245, 158, 11, .55);
                background: rgba(245, 158, 11, .2);
            }

        .news .np-chip .dot {
            width: .45rem;
            height: .45rem;
            border-radius: 50%;
            background: #38BDF8;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, .22);
            animation: np-pulse 2.4s ease-in-out infinite;
        }

    @@keyframes np-pulse {
        0%, 100% {
            box-shadow: 0 0 0 4px rgba(56, 189, 248, .22);
        }

        50% {
            box-shadow: 0 0 0 7px rgba(56, 189, 248, .05);
        }
    }

    .news .np-ticker {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: .9rem;
        margin-bottom: 1.6rem;
        padding: .55rem .9rem;
        border-radius: 12px;
        background: linear-gradient(90deg, rgba(245, 158, 11, .10), rgba(56, 132, 255, .08));
        border: 1px solid rgba(245, 158, 11, .18);
        overflow: hidden;
    }

    .news .np-ticker-label {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .28rem .7rem;
        border-radius: 999px;
        background: linear-gradient(135deg, #F59E0B, #EA580C);
        color: #FFFFFF;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .1em;
        text-transform: uppercase;
        box-shadow: 0 8px 18px -10px rgba(245, 158, 11, .9);
    }

    .news .np-ticker-viewport {
        flex: 1;
        overflow: hidden;
        position: relative;
        mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    }

    .news .np-ticker-track {
        display: inline-flex;
        gap: 2.5rem;
        white-space: nowrap;
        animation: np-ticker 40s linear infinite;
        will-change: transform;
    }

        .news .np-ticker-track:hover {
            animation-play-state: paused;
        }

    .news .np-ticker-item {
        color: #C7D6F1;
        font-size: .88rem;
        font-weight: 500;
    }

        .news .np-ticker-item b {
            color: #FCD9A0;
            font-weight: 700;
            margin-right: .4rem;
        }

    @@keyframes np-ticker {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    .news .np-banner {
        position: relative;
        z-index: 2;
        max-width: 720px;
        padding: .2rem 0 2rem;
    }

    .news .np-badge {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: 1rem;
        padding: .35rem .9rem;
        border-radius: 999px;
        background: rgba(56, 132, 255, .16);
        border: 1px solid rgba(96, 165, 250, .35);
        color: #BFD5FF;
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

        .news .np-badge i {
            width: .4rem;
            height: .4rem;
            border-radius: 50%;
            background: #F59E0B;
            box-shadow: 0 0 0 4px rgba(245, 158, 11, .2);
        }

    .news .np-banner h1 {
        margin: 0 0 .7rem;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-weight: 800;
        font-size: clamp(2rem, 4.8vw, 3.4rem);
        line-height: 1.06;
        letter-spacing: -.025em;
        color: #FFFFFF;
    }

        .news .np-banner h1 .grad {
            background: linear-gradient(135deg, #93C5FD 0%, #38BDF8 55%, #F59E0B 120%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

    .news .np-banner p {
        margin: 0;
        font-size: 1.08rem;
        color: #9BB0D3;
        max-width: 560px;
    }

    .news .np-hero {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        margin-bottom: 3rem;
        overflow: hidden;
        color: inherit;
        text-decoration: none;
        background: linear-gradient(180deg, rgba(90, 140, 220, .10), rgba(90, 140, 220, .04));
        border: 1px solid rgba(120, 170, 255, .18);
        border-radius: 22px;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
    }

        .news .np-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            pointer-events: none;
            background: linear-gradient(135deg, rgba(56, 132, 255, .20), transparent 55%), radial-gradient(600px 300px at 100% 100%, rgba(245, 158, 11, .12), transparent 65%);
            opacity: 0;
            transition: opacity .3s ease;
        }

        .news .np-hero:hover {
            transform: translateY(-4px);
            border-color: rgba(96, 165, 250, .55);
            box-shadow: 0 34px 60px -30px rgba(56, 132, 255, .7);
        }

            .news .np-hero:hover::after {
                opacity: 1;
            }

    .news .np-hero-media {
        position: relative;
        overflow: hidden;
        min-height: 300px;
        background: rgba(90, 140, 220, .06);
    }

        .news .np-hero-media img {
            display: block;
            width: 100%;
            height: 100%;
            max-height: 460px;
            object-fit: cover;
            transition: transform .6s ease;
        }

        .news .np-hero-media::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 55%, rgba(5, 10, 24, .35));
            pointer-events: none;
        }

    .news .np-hero:hover .np-hero-media img {
        transform: scale(1.04);
    }

    .news .np-hero-noimg {
        grid-template-columns: 1fr;
    }

    .news .np-hero-body {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: .9rem;
        padding: clamp(1.4rem, 3vw, 2.4rem);
    }

    .news .np-tag {
        align-self: flex-start;
        padding: .3rem .85rem;
        border-radius: 999px;
        background: linear-gradient(135deg, #3B82F6 0%, #38BDF8 55%, #F59E0B 130%);
        color: #FFFFFF;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        box-shadow: 0 10px 22px -10px rgba(56, 132, 255, .9), inset 0 1px 0 rgba(255, 255, 255, .35);
    }

    .news .np-hero h2 {
        margin: 0;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-weight: 800;
        font-size: clamp(1.6rem, 3vw, 2.25rem);
        line-height: 1.15;
        letter-spacing: -.02em;
        color: #FFFFFF;
    }

    .news .np-hero p {
        margin: 0;
        color: #A9BDDC;
        font-size: 1.02rem;
        line-height: 1.6;
    }

    .news .np-hero-meta {
        display: flex;
        align-items: center;
        gap: .55rem;
        flex-wrap: wrap;
        font-size: .78rem;
        color: #93A7C8;
    }

        .news .np-hero-meta .sep {
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: #5D6E8E;
        }

        .news .np-hero-meta .read {
            color: #FCD9A0;
            font-weight: 600;
        }

    .news .np-hero-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: .5rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(140, 180, 255, .14);
    }

    .news .np-author {
        display: flex;
        align-items: center;
        gap: .65rem;
        font-weight: 600;
        font-size: .9rem;
        color: #E6EEFB;
    }

    .news .np-avatar {
        display: grid;
        place-items: center;
        width: 2.2rem;
        height: 2.2rem;
        border-radius: 50%;
        background: linear-gradient(135deg, #3B82F6, #38BDF8);
        color: #FFFFFF;
        font-size: .9rem;
        font-weight: 700;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .35), 0 6px 16px -8px rgba(56, 132, 255, .9);
    }

    .news .np-more {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-weight: 700;
        font-size: .88rem;
        color: #93C5FD;
        transition: transform .2s ease, color .2s ease;
    }

    .news .np-hero:hover .np-more {
        transform: translateX(4px);
        color: #FCD9A0;
    }

    .news .np-section-head {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin: 0 0 1.4rem;
    }

        .news .np-section-head h2 {
            margin: 0;
            font-family: "Plus Jakarta Sans", sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: -.02em;
            color: #FFFFFF;
            display: inline-flex;
            align-items: center;
            gap: .6rem;
        }

            .news .np-section-head h2::before {
                content: "";
                width: 1.4rem;
                height: 2px;
                border-radius: 2px;
                background: linear-gradient(90deg, #F59E0B, #38BDF8);
            }

        .news .np-section-head span {
            font-size: .8rem;
            color: #7E93BC;
        }

    .news .np-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.4rem;
    }

        .news .np-grid > .article-grid {
            display: contents;
        }

    .news a.nav-link {
        display: block;
        padding: 0;
        color: inherit;
    }

    .news .card {
        position: relative;
        width: auto !important;
        height: 100%;
        overflow: hidden;
        color: #E6EEFB;
        background: linear-gradient(180deg, rgba(90, 140, 220, .10), rgba(90, 140, 220, .03)) !important;
        border: 1px solid rgba(120, 170, 255, .16) !important;
        border-radius: 18px;
        box-shadow: none;
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
        transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
    }

        .news .card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, #3B82F6, #38BDF8 55%, #F59E0B);
            opacity: 0;
            transition: opacity .25s ease;
            z-index: 3;
        }

        .news .card:hover {
            transform: translateY(-5px);
            border-color: rgba(245, 158, 11, .45) !important;
            box-shadow: 0 26px 45px -28px rgba(56, 132, 255, .8), 0 0 0 1px rgba(245, 158, 11, .12);
        }

            .news .card:hover::before {
                opacity: 1;
            }

    .news .card-img-top {
        width: 100%;
        height: 170px;
        object-fit: cover;
        border: 0;
        border-bottom: 1px solid rgba(140, 180, 255, .12);
        transition: transform .5s ease;
    }

    .news .card:hover .card-img-top {
        transform: scale(1.05);
    }

    .news .card-body {
        padding: 1.1rem 1.2rem 1.3rem;
    }

    .news .card-title {
        display: block;
        margin: 0 0 .5rem;
        color: #FFFFFF !important;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-weight: 700;
        font-size: 1.15rem;
        line-height: 1.3;
        letter-spacing: -.01em;
        text-transform: none;
        background: none;
    }

    .news .card-text {
        font-size: .94rem;
        color: #A9BDDC !important;
        line-height: 1.55;
    }

    .news .card-author,
    .news .card .text-muted {
        font-size: .8rem;
        font-weight: 600;
        color: #93C5FD !important;
    }

    .news .np-empty {
        position: relative;
        z-index: 2;
        max-width: 560px;
        padding: 2.5rem 2rem;
        text-align: center;
        background: rgba(90, 140, 220, .08);
        border: 1px dashed rgba(120, 170, 255, .3);
        border-radius: 22px;
    }

        .news .np-empty h2 {
            margin: 0 0 .4rem;
            font-family: "Plus Jakarta Sans", sans-serif;
            font-size: 1.4rem;
            color: #FFFFFF;
        }

        .news .np-empty p {
            margin: 0;
            color: #9BB0D3;
        }

    .news :focus-visible {
        outline: 3px solid rgba(96, 165, 250, .85);
        outline-offset: 2px;
    }

    .news .np-top {
        position: absolute;
        right: clamp(1rem, 3vw, 2rem);
        bottom: clamp(1rem, 3vw, 2rem);
        z-index: 5;
        display: grid;
        place-items: center;
        width: 2.8rem;
        height: 2.8rem;
        border: 1px solid rgba(120, 170, 255, .3);
        border-radius: 14px;
        background: linear-gradient(180deg, rgba(56, 132, 255, .25), rgba(56, 132, 255, .1));
        color: #C7D6F1;
        cursor: pointer;
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
        box-shadow: 0 14px 30px -18px rgba(56, 132, 255, .9);
        transition: transform .2s ease, border-color .2s ease, color .2s ease;
    }

        .news .np-top:hover {
            transform: translateY(-3px);
            border-color: rgba(245, 158, 11, .55);
            color: #FCD9A0;
        }

        .news .np-top svg {
            width: 1.1rem;
            height: 1.1rem;
        }

    @@media (max-width: 820px) {
        .news {
            border-radius: 20px;
        }

            .news .np-hero {
                grid-template-columns: 1fr;
            }

            .news .np-hero-media {
                min-height: 200px;
                max-height: 260px;
            }

            .news .np-head {
                justify-content: center;
                text-align: center;
            }

            .news .np-ticker {
                flex-direction: column;
                align-items: stretch;
                gap: .5rem;
            }

            .news .np-ticker-track {
                animation-duration: 30s;
            }
    }

    @@media (prefers-reduced-motion: reduce) {
        .news .np-hero, .news .card, .news .np-chip, .news .np-top {
            transition: none;
        }

            .news .np-hero:hover, .news .card:hover, .news .np-top:hover {
                transform: none;
            }

                .news .np-hero:hover .np-hero-media img, .news .card:hover .card-img-top {
                    transform: none;
                }

                .news .np-hero:hover .np-more {
                    transform: none;
                }

            .news .np-chip .dot {
                animation: none;
            }

        .news .np-leaf, .news .np-ticker-track {
            animation: none;
        }

        .news .np-leaf {
            display: none;
        }

        .news::before, .news::after {
            animation: none;
        }
    }
</style>

<div class="news">

    <div class="np-bg" aria-hidden="true"></div>

    <div class="np-leaves" aria-hidden="true">
        @foreach (var l in leaves)
        {
            <span class="np-leaf"
                  style="--x:@F(l.X)%; --s:@(F(l.Size))px; --dur:@(F(l.Dur))s; --delay:@(F(l.Delay))s; --dx:@(F(l.Dx))px; --rot:@(F(l.Rot))deg; --op:@(F(l.Op)); --sway:@(F(l.Sway))s; --c:@l.Color;">
                <svg viewBox="0 0 32 32" aria-hidden="true">
                    <path d="M16 2 C8 6 4 12 4 18 C4 24 9 29 16 30 C23 29 28 24 28 18 C28 12 24 6 16 2 Z" fill="currentColor" opacity="0.9" />
                    <path d="M16 3 V29" stroke="rgba(0,0,0,.35)" stroke-width="1" fill="none" />
                    <path d="M16 10 L10 14 M16 14 L22 18 M16 20 L10 24" stroke="rgba(0,0,0,.25)" stroke-width="1" fill="none" />
                </svg>
            </span>
        }
    </div>

    <header class="np-head">
        <div class="np-brand">
            <span class="np-logo">GS</span>
            <span class="np-brand-text">
                <span class="np-brand-name">Gazetka Szkolna</span>
                <span class="np-brand-sub">Wydanie internetowe · Nr @EditionNumber</span>
            </span>
        </div>

        <div class="np-meta">
            <span class="np-chip"><span class="dot"></span>Na żywo</span>
            <span class="np-chip amber">🍂 Jesień @DateTime.Now.Year</span>
            <span class="np-chip">@DateTime.Now.ToString("d MMMM yyyy", new CultureInfo("pl-PL"))</span>
        </div>
    </header>

    @if (tickerItems.Count > 0)
    {
        <div class="np-ticker" aria-label="Najnowsze nagłówki">
            <span class="np-ticker-label">
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4" fill="currentColor" /></svg>
                Świeże
            </span>
            <div class="np-ticker-viewport">
                <div class="np-ticker-track">
                    @foreach (var item in tickerItems)
                    {
                        <span class="np-ticker-item"><b>•</b>@item</span>
                    }
                    @foreach (var item in tickerItems)
                    {
                        <span class="np-ticker-item" aria-hidden="true"><b>•</b>@item</span>
                    }
                </div>
            </div>
        </div>
    }

    <section class="np-banner">
        <span class="np-badge"><i></i>Szkolna gazetka online</span>
        <h1>Najnowsze <span class="grad">wieści</span> z życia szkoły</h1>
        <p>Aktualności, wydarzenia i teksty uczniów w jednym miejscu.</p>
    </section>

    @if (featured is null)
    {
        <div class="np-empty">
            <h2>Nie ma jeszcze żadnych artykułów</h2>
            <p>Pierwszy tekst pojawi się tutaj, gdy redaktor doda go w panelu administratora.</p>
        </div>
    }
    else
    {
        <a class="np-hero @(featuredImage is null ? "np-hero-noimg" : "")" href="/article/@featured.Id">
            @if (featuredImage is not null)
            {
                <div class="np-hero-media">
                    <img src="@featuredImage" alt="@featured.Title" />
                </div>
            }

            <div class="np-hero-body">
                <span class="np-tag">Najnowszy artykuł</span>
                <h2>@featured.Title</h2>
                <p>@Preview(featured.Text, 260)</p>

                <div class="np-hero-meta">
                    <span>@DateTime.Now.ToString("d MMM yyyy", new CultureInfo("pl-PL"))</span>
                    <span class="sep"></span>
                    <span class="read">@ReadingTime(featured.Text)</span>
                    <span class="sep"></span>
                    <span>@WordCount(featured.Text) słów</span>
                </div>

                <div class="np-hero-footer">
                    <span class="np-author">
                        <span class="np-avatar">@Initial(featured.Author)</span>
                        @featured.Author
                    </span>
                    <span class="np-more">Czytaj dalej →</span>
                </div>
            </div>
        </a>

        @if (rest.Count > 0)
        {
            <div class="np-section-head">
                <h2>Starsze artykuły</h2>
                <span>Archiwum redakcji · @rest.Count tekstów</span>
            </div>

            <div class="np-grid">
                <ArticleCard Articles="rest" permissions="false" />
            </div>
        }
    }

    <button class="np-top" type="button" aria-label="Wróć na górę" onclick="window.scrollTo({ top: 0, behavior: 'smooth' });">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7" />
        </svg>
    </button>

</div>

@code
{
    private record Leaf(double X, double Size, double Dur, double Delay, double Dx, double Rot, double Op, double Sway, string Color);

    private readonly List<Leaf> leaves = new();

    private static readonly string[] LeafColors = new[]
    {
        "#F59E0B",
        "#EA580C",
        "#DC2626",
        "#D97706",
        "#CA8A04",
        "#B45309"
    };

    private Article? featured;
    private List<Article> rest = new();
    private string? featuredImage;

    private int EditionNumber => DateTime.Now.DayOfYear;

    private List<string> tickerItems = new();

    protected override async Task OnInitializedAsync()
    {
        var rnd = new Random(11);
        for (int i = 0; i < 14; i++)
        {
            leaves.Add(new Leaf(
                X: rnd.NextDouble() * 100,
                Size: 14 + rnd.NextDouble() * 18,
                Dur: 14 + rnd.NextDouble() * 14,
                Delay: -rnd.NextDouble() * 20,
                Dx: (rnd.NextDouble() - 0.5) * 220,
                Rot: (rnd.NextDouble() - 0.5) * 720,
                Op: 0.35 + rnd.NextDouble() * 0.45,
                Sway: 3 + rnd.NextDouble() * 3,
                Color: LeafColors[rnd.Next(LeafColors.Length)]));
        }

        var all = (await articleService.GetAllArticlesAsync())
            .OrderByDescending(a => a.Id)
            .ToList();

        featured = all.FirstOrDefault();
        rest = all.Skip(1).ToList();

        tickerItems = all
            .Take(6)
            .Select(a => a.Title ?? "")
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .ToList();

        if (featured is not null)
        {
            var fileName = await fileService.GetFileNameByIdAsync(featured.FileID);
            if (!string.IsNullOrWhiteSpace(fileName))
            {
                featuredImage = $"/Images/{fileName}";
            }
        }
    }

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Preview(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        return text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "…";
    }

    private static string Initial(string? name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpper();

    private static int WordCount(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return 0;
        return text.Split(new[] { ' ', '\t', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private static string ReadingTime(string? text)
    {
        var words = WordCount(text);
        var minutes = Math.Max(1, (int)Math.Ceiling(words / 200.0));
        return $"{minutes} min czytania";
    }
}