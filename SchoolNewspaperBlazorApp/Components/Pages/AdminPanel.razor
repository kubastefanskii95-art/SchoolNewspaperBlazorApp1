@page "/adminPanel"
@rendermode InteractiveServer
@inject IArticleService articleService
@inject IAuthService AuthService

@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service

<PageTitle>Panel administratora</PageTitle>

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="adm-eg" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#FFFFFF" />
            <stop offset="1" stop-color="#7DD3FC" />
        </linearGradient>
        <symbol id="adm-eagle" viewBox="0 0 200 160">
            <g fill="url(#adm-eg)">
                <path d="M100 52 C86 66 84 100 100 134 C116 100 114 66 100 52Z" />
                <path d="M90 128 L100 158 L110 128Z" />
                <circle cx="100" cy="38" r="14" />
                <path d="M109 34 L128 43 L110 48Z" />
                <path d="M88 62 C60 40 30 38 6 52 C22 54 30 60 34 70 C24 70 14 74 8 82 C26 80 36 84 42 92 C34 94 28 100 24 108 C44 102 62 104 76 114 C84 96 88 78 88 62Z" />
                <path transform="translate(200 0) scale(-1 1)" d="M88 62 C60 40 30 38 6 52 C22 54 30 60 34 70 C24 70 14 74 8 82 C26 80 36 84 42 92 C34 94 28 100 24 108 C44 102 62 104 76 114 C84 96 88 78 88 62Z" />
            </g>
        </symbol>
    </defs>
</svg>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

    .main-block.adm {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        min-height: 540px;
        padding: clamp(1.25rem, 4vw, 3rem);
        border-radius: 32px;
        background-color: #071A3A !important;
        background-image: none !important;
        color: #E2ECFB !important;
        font-family: "Inter", "Segoe UI", system-ui, sans-serif;
        box-shadow: 0 40px 80px -30px rgba(7, 26, 58, .85);
    }

    /* ---------- Tło ---------- */
    .adm .adm-base {
        position: absolute;
        inset: 0;
        z-index: -4;
        background: linear-gradient(160deg, #0B2250 0%, #071A3A 55%, #05122B 100%);
    }

    .adm .adm-aurora {
        position: absolute;
        inset: -20%;
        z-index: -3;
        opacity: .55;
        background: radial-gradient(40% 40% at 18% 18%, rgba(37, 99, 235, .65), transparent 70%), radial-gradient(35% 35% at 85% 12%, rgba(56, 189, 248, .4), transparent 70%), radial-gradient(45% 45% at 70% 95%, rgba(30, 64, 175, .6), transparent 70%);
        filter: blur(30px);
        animation: adm-drift 18s ease-in-out infinite alternate;
    }

    .adm::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -2;
        background-image: linear-gradient(rgba(147, 197, 253, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(147, 197, 253, .06) 1px, transparent 1px);
        background-size: 44px 44px;
        -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 15%, transparent 75%);
        mask-image: radial-gradient(ellipse at 50% 0%, #000 15%, transparent 75%);
    }

    @@keyframes adm-drift {
        from {
            transform: translate3d(-3%, -2%, 0) scale(1);
        }

        to {
            transform: translate3d(3%, 2%, 0) scale(1.1);
        }
    }

    .adm .adm-watermark {
        position: absolute;
        top: -30px;
        right: -50px;
        width: 400px;
        z-index: -1;
        opacity: .07;
        transform: rotate(-8deg);
        pointer-events: none;
    }

    /* ---------- Nagłówek ---------- */
    .adm .adm-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .adm .adm-brand {
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

    .adm .adm-emblem {
        display: grid;
        place-items: center;
        flex: none;
        width: 4.6rem;
        height: 4.6rem;
        border-radius: 50%;
        background: rgba(255, 255, 255, .1);
        border: 1px solid rgba(147, 197, 253, .5);
        box-shadow: 0 0 40px -6px rgba(56, 189, 248, .55);
    }

        .adm .adm-emblem svg {
            width: 2.9rem;
            height: 2.3rem;
        }

    .adm .adm-live {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.7rem;
        padding: 0.28rem 0.85rem;
        border-radius: 999px;
        background: rgba(56, 189, 248, .2);
        border: 1px solid rgba(125, 211, 252, .6);
        color: #BAE6FD !important;
        font-size: 0.82rem;
        font-weight: 600;
    }

        .adm .adm-live i {
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: #38BDF8;
            animation: adm-pulse 2.2s infinite;
        }

    @@keyframes adm-pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(56, 189, 248, .7);
        }

        70% {
            box-shadow: 0 0 0 9px rgba(56, 189, 248, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(56, 189, 248, 0);
        }
    }

    .adm .adm-head h1 {
        margin: 0 0 0.5rem;
        font-family: "Space Grotesk", "Inter", sans-serif;
        font-weight: 700;
        font-size: clamp(1.9rem, 4.6vw, 3.1rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
        text-transform: none;
        color: #FFFFFF !important;
        -webkit-text-fill-color: #FFFFFF;
        text-shadow: 0 2px 24px rgba(0, 0, 0, .4);
    }

    .adm .adm-head p {
        margin: 0;
        max-width: 46ch;
        font-size: 1.05rem;
        color: #C9D9F3 !important;
    }

    .adm .adm-stat {
        display: flex;
        flex-direction: column;
        min-width: 11rem;
        padding: 1rem 1.4rem;
        border-radius: 20px;
        background: rgba(255, 255, 255, .1);
        border: 1px solid rgba(147, 197, 253, .4);
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
    }

        .adm .adm-stat strong {
            font-family: "Space Grotesk", sans-serif;
            font-size: 2.4rem;
            line-height: 1;
            color: #FFFFFF !important;
        }

        .adm .adm-stat span {
            margin-top: 0.3rem;
            font-size: 0.88rem;
            color: #C9D9F3 !important;
        }

    /* ---------- Kafelki menu ---------- */
    .adm .adm-tiles {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
    }

    .adm .adm-tile {
        --c1: #3B82F6;
        --c2: #22D3EE;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        width: 100%;
        min-height: 230px;
        padding: 1.5rem;
        text-align: left;
        cursor: pointer;
        color: #fff;
        font-family: inherit;
        border: 1px solid transparent;
        border-radius: 24px;
        background: linear-gradient(160deg, #0F2750, #0A1B3D) padding-box, linear-gradient(135deg, rgba(147, 197, 253, .25), rgba(147, 197, 253, .1)) border-box;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .adm .adm-tile::after {
            content: "";
            position: absolute;
            top: -70px;
            right: -70px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--c1), transparent 70%);
            opacity: .25;
            transition: opacity .3s ease;
            pointer-events: none;
        }

        .adm .adm-tile:hover {
            transform: translateY(-6px);
            box-shadow: 0 30px 50px -25px var(--c1);
            background: linear-gradient(160deg, #0F2750, #0A1B3D) padding-box, linear-gradient(135deg, var(--c1), var(--c2)) border-box;
        }

            .adm .adm-tile:hover::after {
                opacity: .55;
            }

        .adm .adm-tile:active {
            transform: translateY(-2px) scale(.99);
        }

        .adm .adm-tile.t-articles {
            --c1: #3B82F6;
            --c2: #22D3EE;
        }

        .adm .adm-tile.t-new {
            --c1: #6366F1;
            --c2: #38BDF8;
        }

        .adm .adm-tile.t-user {
            --c1: #0EA5E9;
            --c2: #2DD4BF;
        }

    .adm .adm-icon {
        display: grid;
        place-items: center;
        width: 3.4rem;
        height: 3.4rem;
        margin-bottom: 0.6rem;
        border-radius: 18px;
        background: linear-gradient(135deg, var(--c1), var(--c2));
        box-shadow: 0 14px 26px -12px var(--c1);
        color: #fff;
    }

        .adm .adm-icon svg {
            width: 1.6rem;
            height: 1.6rem;
        }

    .adm .adm-tile-title {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 600;
        font-size: 1.45rem;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: #FFFFFF !important;
    }

    .adm .adm-tile-desc {
        font-size: 0.95rem;
        color: #C9D9F3 !important;
    }

    .adm .adm-go {
        margin-top: auto;
        font-size: 1.4rem;
        color: var(--c2);
        transition: transform .25s ease;
    }

    .adm .adm-tile:hover .adm-go {
        transform: translateX(6px);
    }

    /* ---------- Pasek podstron ---------- */
    .adm .adm-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .adm .adm-back {
        padding: 0.55rem 1.2rem;
        cursor: pointer;
        color: #FFFFFF !important;
        font-family: inherit;
        font-weight: 600;
        border-radius: 999px;
        background: rgba(255, 255, 255, .1);
        border: 1px solid rgba(147, 197, 253, .4);
        transition: background .2s ease, transform .2s ease;
    }

        .adm .adm-back:hover {
            background: rgba(255, 255, 255, .2);
            transform: translateX(-3px);
        }

    .adm .adm-crumb {
        color: #B4C6E4 !important;
        font-weight: 500;
    }

        .adm .adm-crumb strong {
            color: #FFFFFF !important;
            font-weight: 600;
        }

    /* ---------- Lista artykułów ---------- */
    .adm .adm-articles {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.4rem;
    }

        .adm .adm-articles > .article-grid {
            display: contents;
        }

    .adm .card {
        width: auto !important;
        height: 100%;
        overflow: hidden;
        color: #E2ECFB;
        background: rgba(255, 255, 255, .08) !important;
        border: 1px solid rgba(147, 197, 253, .3) !important;
        border-radius: 20px;
        box-shadow: none;
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
    }

        .adm .card:hover {
            transform: translateY(-4px);
            border-color: rgba(56, 189, 248, .8) !important;
            box-shadow: 0 24px 40px -24px rgba(56, 189, 248, .7);
        }

    .adm .card-img-top {
        width: 100%;
        height: 170px;
        object-fit: cover;
        border: 0;
    }

    .adm .card-body {
        padding: 1.1rem 1.2rem 1.3rem;
    }

    .adm .card-title {
        display: block;
        margin: 0 0 0.5rem;
        color: #FFFFFF !important;
        font-family: "Space Grotesk", sans-serif;
        font-weight: 600;
        font-size: 1.2rem;
        line-height: 1.25;
        text-transform: none;
        background: none;
    }

    .adm .card-text {
        font-size: 0.93rem;
        color: #C9D9F3 !important;
    }

    .adm .card-author,
    .adm .card .text-muted {
        font-size: 0.85rem;
        font-weight: 600;
        color: #7DD3FC !important;
    }

    .adm .card-footer {
        background: transparent;
        border-top: 1px solid rgba(147, 197, 253, .25);
    }

    .adm .adm-empty {
        max-width: 520px;
        padding: 2.5rem 2rem;
        text-align: center;
        border-radius: 22px;
        border: 2px dashed rgba(147, 197, 253, .4);
    }

        .adm .adm-empty h2 {
            margin: 0 0 0.4rem;
            color: #FFFFFF !important;
            font-family: "Space Grotesk", sans-serif;
            font-size: 1.5rem;
        }

        .adm .adm-empty p {
            margin: 0;
            color: #C9D9F3 !important;
        }

    /* ---------- Formularze ---------- */
    .adm .adm-card,
    .adm .add-article-form {
        max-width: 560px;
        padding: 1.75rem;
        border-radius: 24px;
        background: rgba(255, 255, 255, .08);
        border: 1px solid rgba(147, 197, 253, .3);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
    }

    .adm .add-article-form {
        max-width: 720px;
    }

        .adm .adm-card h3,
        .adm .add-article-form h1 {
            margin: 0 0 1.2rem;
            color: #FFFFFF !important;
            font-family: "Space Grotesk", sans-serif;
            font-weight: 600;
            font-size: 1.7rem;
            letter-spacing: -0.02em;
            text-transform: none;
        }

    .adm .form-label,
    .adm label {
        margin-bottom: 0.35rem;
        color: #FFFFFF !important;
        font-size: 0.92rem;
        font-weight: 600;
    }

    .adm .form-control,
    .adm .add-article-form input,
    .adm .add-article-form textarea {
        padding: 0.7rem 0.95rem;
        color: #FFFFFF !important;
        background: rgba(255, 255, 255, .1) !important;
        border: 1px solid rgba(147, 197, 253, .4);
        border-radius: 12px;
    }

        .adm .form-control::placeholder {
            color: #9FB4D9;
        }

        .adm .form-control:focus,
        .adm .add-article-form input:focus,
        .adm .add-article-form textarea:focus {
            outline: 0;
            border-color: #38BDF8;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, .25);
        }

    .adm .add-article-form input,
    .adm .add-article-form textarea {
        margin-bottom: 0.9rem;
    }

    .adm .add-article-form textarea {
        min-height: 180px;
    }

    .adm input[type="file"]::file-selector-button {
        margin-right: 0.9rem;
        padding: 0.4rem 1rem;
        cursor: pointer;
        color: #fff;
        font-weight: 600;
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #2563EB, #38BDF8);
    }

    .adm .preview-image img,
    .adm .add-article-form img {
        max-height: 200px;
        margin: 0.4rem 0 0.9rem;
        border-radius: 14px;
        border: 1px solid rgba(147, 197, 253, .4);
    }

    .adm .validation-message,
    .adm .validation-errors,
    .adm .text-danger {
        color: #FDA4AF !important;
        font-size: 0.88rem;
        font-weight: 500;
    }

    .adm .form-control.invalid,
    .adm input.invalid {
        border-color: #FB7185;
    }

    .adm .alert {
        padding: 0.8rem 1.1rem;
        color: #E0F2FE !important;
        font-weight: 500;
        border-radius: 14px;
        background: rgba(56, 189, 248, .15);
        border: 1px solid rgba(56, 189, 248, .5);
    }

    /* ---------- Przyciski ---------- */
    .adm .btn {
        padding: 0.65rem 1.4rem;
        color: #fff;
        font-weight: 700;
        border: 0;
        border-radius: 999px;
        transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
    }

        .adm .btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
            color: #fff;
        }

        .adm .btn:active {
            transform: translateY(0);
        }

    .adm .btn-primary {
        background: linear-gradient(135deg, #2563EB, #38BDF8);
        box-shadow: 0 14px 26px -12px rgba(37, 99, 235, .9);
    }

    .adm .btn-success {
        background: linear-gradient(135deg, #0EA5E9, #2DD4BF);
        box-shadow: 0 14px 26px -12px rgba(14, 165, 233, .9);
    }

    .adm .btn-danger {
        padding: 0.45rem 1.1rem;
        background: linear-gradient(135deg, #F43F5E, #FB7185);
        box-shadow: 0 12px 22px -12px rgba(244, 63, 94, .9);
    }

    .adm :focus-visible {
        outline: 3px solid rgba(125, 211, 252, .85);
        outline-offset: 2px;
    }

    /* ---------- Telefon i dostępność ---------- */
    @@media (max-width: 640px) {
        .main-block.adm {
            border-radius: 24px;
        }

        .adm .adm-stat {
            width: 100%;
        }

        .adm .adm-watermark {
            width: 260px;
            right: -60px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .adm .adm-aurora, .adm .adm-live i {
            animation: none;
        }

        .adm .adm-tile, .adm .card, .adm .btn, .adm .adm-back, .adm .adm-go {
            transition: none;
        }

            .adm .adm-tile:hover, .adm .card:hover, .adm .btn:hover {
                transform: none;
            }
    }
</style>

<div class="main-block adm" style="background-color:#071A3A; color:#E2ECFB;">
    <div class="adm-base" aria-hidden="true"></div>
    <div class="adm-aurora" aria-hidden="true"></div>
    <svg class="adm-watermark" viewBox="0 0 200 160" aria-hidden="true"><use href="#adm-eagle" /></svg>

    @if (view == 0)
    {
        <header class="adm-head">
            <div class="adm-brand">
                <span class="adm-emblem">
                    <svg viewBox="0 0 200 160" aria-hidden="true"><use href="#adm-eagle" /></svg>
                </span>
                <div>
                    <span class="adm-live"><i></i>Panel aktywny</span>
                    <h1>Centrum dowodzenia redakcji</h1>
                    <p>Publikuj artykuły, porządkuj gazetkę i zarządzaj kontami redaktorów.</p>
                </div>
            </div>

            <div class="adm-stat">
                <strong>@articleCount</strong>
                <span>artykułów w gazetce</span>
            </div>
        </header>

        <div class="adm-tiles">
            <button class="adm-tile t-articles" @onclick="LoadArticleAsync">
                <span class="adm-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                </span>
                <span class="adm-tile-title">Panel artykułów</span>
                <span class="adm-tile-desc">Przeglądaj wszystkie teksty i usuwaj te, których już nie potrzebujesz.</span>
                <span class="adm-go">→</span>
            </button>

            <button class="adm-tile t-new" @onclick="() => SetView(2)">
                <span class="adm-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                </span>
                <span class="adm-tile-title">Dodaj artykuł</span>
                <span class="adm-tile-desc">Napisz nowy tekst, dodaj zdjęcie i opublikuj go w gazetce.</span>
                <span class="adm-go">→</span>
            </button>

            <button class="adm-tile t-user" @onclick="() => SetView(3)">
                <span class="adm-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M22 11h-6" /></svg>
                </span>
                <span class="adm-tile-title">Dodaj użytkownika</span>
                <span class="adm-tile-desc">Załóż konto dla nowego redaktora lub opiekuna gazetki.</span>
                <span class="adm-go">→</span>
            </button>
        </div>
    }
    else
    {
        <div class="adm-bar">
            <button class="adm-back" @onclick="BackAsync">← Wróć</button>
            <span class="adm-crumb">
                Panel administratora / <strong>@(view switch { 1 => "Artykuły", 2 => "Nowy artykuł", _ => "Nowy użytkownik" })</strong>
            </span>
        </div>

        @if (view == 1)
        {
            @if (articleList.Count == 0)
            {
                <div class="adm-empty">
                    <h2>Brak artykułów</h2>
                    <p>Dodaj pierwszy tekst, a pojawi się tutaj.</p>
                </div>
            }
            else
            {
                <div class="article-panel adm-articles">
                    <ArticleCard Articles="articleList" permissions="true" />
                </div>
            }
        }
        else if (view == 2)
        {
            <ArticleForm />
        }
        else if (view == 3)
        {
            <div class="adm-card">
                <h3>Dodaj użytkownika</h3>

                <EditForm Model="@newUser" OnValidSubmit="AddUserAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Login</label>
                        <InputText class="form-control"
                                   @bind-Value="newUser.Login" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hasło</label>
                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="newUser.Haslo" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control"
                                   @bind-Value="newUser.Email" />
                    </div>

                    <button type="submit" class="btn btn-success">
                        Dodaj użytkownika
                    </button>
                </EditForm>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="alert alert-info mt-3">
                        @message
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    public int view = 0;

    public List<Article> articleList = new();

    private User newUser = new();

    private string message = string.Empty;

    private int articleCount;

    protected override async Task OnInitializedAsync()
    {
        articleCount = (await articleService.GetAllArticlesAsync()).Count;
    }

    public void SetView(int view)
    {
        this.view = view;
        message = string.Empty;
    }

    private async Task BackAsync()
    {
        SetView(0);
        articleCount = (await articleService.GetAllArticlesAsync()).Count;
    }

    public async Task LoadArticleAsync()
    {
        articleList = await articleService.GetAllArticlesAsync();
        articleCount = articleList.Count;
        SetView(1);
    }

    private async Task AddUserAsync()
    {
        bool success = await AuthService.RegisterAsync(newUser);

        if (success)
        {
            message = "Użytkownik został dodany.";
            newUser = new User();
        }
        else
        {
            message = "Użytkownik o takim loginie lub adresie email już istnieje.";
        }
    }
}